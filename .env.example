# Environment Configuration for KASPARRO Claim Checker
# Copy to .env and configure with your local parameters. Never commit real keys.

APP_NAME="KASPARRO AI Claim Extraction & Fact Verification Service"
ENV="development"
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# LLM Providers (Required for Phase 2 Agent Implementation)
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# Data Paths
DATA_DIR="data"
ANSWERS_FILE="data/answers.csv"
BRAND_FACTS_FILE="data/brand_facts.csv"
DEVELOPMENT_GOLD_FILE="data/development_gold.csv"

# Storage
DATABASE_URL="sqlite:///./kasparro.db"

